<odoo>
    <record id="group_librarian" model="res.groups">
        <field name="name">Bibliotecario</field>
    </record>

    <record id="group_public_user" model="res.groups">
        <field name="name">Usuario Público</field>
    </record>

    <record id="rule_books_available_only" model="ir.rule">
        <field name="name">Solo libros disponibles</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[('state', '=', 'available')]</field>
        <field name="groups" eval="[(4, ref('library_management.group_public_user'))]"/>
    </record> 
</odoo>